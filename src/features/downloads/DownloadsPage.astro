---
import type { Locale } from '@/types/locale';
import BaseLayout from '@/components/layout/BaseLayout.astro';
import { PlatformDownloadMatrix } from '@/features/downloads/PlatformDownloadMatrix';
import { QuickInstallTabs } from '@/features/downloads/QuickInstallTabs';
import ChangelogTimeline from '@/features/downloads/ChangelogTimeline.astro';
import { getSiteCopy } from '@/data/site-copy';
import {
  getDownloadGroups,
  getQuickInstallMethods,
  getReleaseLogs,
} from '@/data/releases-data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getSiteCopy(locale);
const groups = getDownloadGroups(locale);
const installMethods = getQuickInstallMethods(locale);
const releaseLogs = getReleaseLogs(locale);
---

<BaseLayout
  copy={copy}
  title={copy.meta.downloadsTitle}
  description={copy.meta.downloadsDescription}
  currentPage="downloads"
>
  <section class="relative" data-section>
    <div class="wrap pt-10 pb-14 md:pt-14 md:pb-18">
      <div class="max-w-[44rem]">
        <p class="text-[0.8125rem] text-[var(--quiet)]">Mark Shot 0.2.1</p>
        <h1 class="mt-2.5 text-[clamp(2rem,3.4vw,3rem)] leading-[1.12] font-normal text-[var(--ink)]">
          {copy.downloadsPage.heading}
        </h1>
        <p class="mt-3 text-[1.0625rem] leading-[1.65] text-[var(--soft)]">
          {copy.downloadsPage.subheading}
        </p>
      </div>

      <PlatformDownloadMatrix
        client:load
        groups={groups}
        copy={copy.downloadsPage}
      />
    </div>
  </section>

  <QuickInstallTabs
    client:visible
    methods={installMethods}
    heading={copy.downloadsPage.quickInstallHeading}
    subheading={copy.downloadsPage.quickInstallSubheading}
    verifyHeading={copy.downloadsPage.verifyHeading}
    verifyBody={copy.downloadsPage.verifyBody}
    commonCopy={copy.common}
  />

  <ChangelogTimeline copy={copy.downloadsPage} logs={releaseLogs} />
</BaseLayout>
