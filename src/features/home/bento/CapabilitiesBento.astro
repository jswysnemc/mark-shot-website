---
import type { SiteCopy } from '@/types/locale';
import { getCapabilitiesData } from '@/data/capabilities-data';
import { BentoVisual } from '@/features/home/bento/BentoVisuals';
import { withBase } from '@/utils/paths';

interface Props {
  copy: SiteCopy['capabilities'];
  locale: SiteCopy['locale'];
}

const { copy, locale } = Astro.props;
const isZh = locale === 'zh-cn';
const cards = getCapabilitiesData(locale);
const frameImgSrc = withBase('/images/export-frame-card.png');
const backdropSrc = withBase('/images/capture-backdrop.jpg');

const spanClassMap: Record<2 | 3 | 4, string> = {
  2: 'lg:col-span-2',
  3: 'lg:col-span-3',
  4: 'lg:col-span-4',
};
---

<section id="capabilities" class="relative" data-section data-hatch-band>
  <div class="wrap pt-16 pb-16 md:pt-22 md:pb-24">
    <div class="max-w-[42rem]">
      <h2 class="text-[clamp(1.65rem,2.5vw,2.25rem)] leading-[1.12] font-normal text-[var(--ink)]">
        {copy.heading}
      </h2>
      <p class="mt-3 text-[1rem] leading-[1.65] text-[var(--soft)]">
        {copy.subheading}
      </p>
    </div>

    <ul
      class="no-scrollbar -mx-[var(--edge)] mt-9 flex snap-x snap-mandatory gap-4 overflow-x-auto px-[var(--edge)] pb-2 sm:mx-0 sm:grid sm:grid-cols-2 sm:overflow-visible sm:px-0 sm:pb-0 lg:grid-cols-6"
    >
      {
        cards.map((card, index) => (
          <li
            class:list={[
              'flex w-[84vw] shrink-0 snap-start flex-col overflow-hidden rounded-2xl border border-[var(--rule)] bg-[var(--card)] sm:w-auto',
              index === 0 ? 'sm:col-span-2' : 'sm:col-span-1',
              spanClassMap[card.span],
            ]}
          >
            <BentoVisual
              kind={card.id}
              isZh={isZh}
              frameImgSrc={frameImgSrc}
              backdropSrc={backdropSrc}
            />
            <div class="flex flex-1 flex-col justify-between px-5 py-5">
              <div>
                <h3 class="text-[1.1875rem] leading-[1.2] font-normal text-[var(--ink)]">
                  {card.title}
                </h3>
                <p class="mt-2 text-[0.9375rem] leading-[1.6] text-[var(--soft)]">
                  {card.description}
                </p>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
