---
import type { SiteCopy } from '@/types/locale';
import { withBase } from '@/utils/paths';

interface Props {
  copy: SiteCopy['downloadCallout'];
  locale: SiteCopy['locale'];
}

const { copy, locale } = Astro.props;
const downloadsBase = locale === 'zh-cn' ? '/zh-cn/downloads/' : '/downloads/';
const startHref = withBase(`${downloadsBase}?start`);
const allHref = withBase(downloadsBase);
---

<section class="relative" data-section data-hatch-band>
  <div class="wrap pt-14 pb-16 md:pt-20 md:pb-24">
    <div
      class="rounded-[24px] border border-[var(--rule)] bg-[color-mix(in_srgb,var(--accent)_4%,var(--card))] p-6 sm:p-10 md:p-12"
    >
      <div class="max-w-[40rem]">
        <h2 class="text-[clamp(1.7rem,2.6vw,2.35rem)] leading-[1.12] font-normal text-[var(--ink)]">
          {copy.heading}
        </h2>
        <p class="mt-3 text-[1rem] leading-[1.65] text-[var(--soft)]">
          {copy.body}
        </p>
      </div>

      <ul
        class="mt-8 grid grid-cols-1 gap-6 border-t border-[var(--rule)] pt-6 md:grid-cols-3"
      >
        {
          copy.slots.map((slot) => (
            <li class="flex flex-col gap-1.5">
              <span class="text-[1.2rem] leading-[1.2] text-[var(--ink)]">
                {slot.platform}
              </span>
              <span class="text-[0.875rem] leading-[1.55] text-[var(--soft)]">
                {slot.requirement}
              </span>
            </li>
          ))
        }
      </ul>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={startHref} class="btn-pill btn-pill--ink">
          {copy.primaryCta}
        </a>
        <a href={allHref} class="btn-pill btn-pill--line">
          {copy.secondaryCta}
        </a>
      </div>
    </div>
  </div>
</section>
